{
  "name": "tabs-a11y",
  "version": "1.0.2",
  "description": "Tabs with Full Accessibility ",
  "keywords": [
    "tabs",
    "tab",
    "a11y",
    "wcag",
    "accessible tabs",
    "wai-aria",
    "aria",
    "keyboard navigation tabs",
    "tabpanel",
    "js",
    "javascript",
    "horizontal tabs"
  ],
  "main": "./dist/js/tabs-a11y.cjs",
  "module": "./dist/js/tabs-a11y.mjs",
  "types": "./dist/js/tabs-a11y.d.ts",
  "unpkg": "./dist/js/tabs-a11y.umd.js",
  "jsdelivr": "./dist/js/tabs-a11y.umd.js",
  "exports": {
    ".": {
      "types": "./dist/js/tabs-a11y.d.ts",
      "import": "./dist/js/tabs-a11y.mjs",
      "require": "./dist/js/tabs-a11y.cjs",
      "default": "./dist/js/tabs-a11y.mjs"
    },
    "./style.css": "./dist/css/styles.min.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:js": "vite build",
    "build:types": "cp src/js/script.d.ts dist/js/tabs-a11y.d.ts",
    "build:css": "sass src/scss/styles.scss:dist/css/styles.min.css --style=compressed --no-source-map",
    "build": "npm run build:js && npm run build:types && npm run build:css",
    "dev:js": "vite build --watch",
    "dev:css": "sass --watch src/scss/styles.scss:dist/css/styles.min.css --no-source-map",
    "test": "node --test"
  },
  "author": "Bartosz Trajder",
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^30.0.1",
    "sass": "^1.103.1",
    "vite": "^8.2.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sargadil/tabs.git"
  }
}
