{
  "name": "@sargadil/tabs",
  "version": "1.2.0",
  "description": "Lightweight, dependency-free tabs following the WAI-ARIA Tabs Pattern.",
  "keywords": [
    "tabs",
    "tab",
    "a11y",
    "wcag",
    "accessible tabs",
    "wai-aria",
    "aria",
    "keyboard navigation tabs",
    "tabpanel",
    "js",
    "javascript",
    "horizontal tabs"
  ],
  "main": "./dist/js/tabs.cjs",
  "module": "./dist/js/tabs.mjs",
  "types": "./dist/js/tabs.d.ts",
  "unpkg": "./dist/js/tabs.umd.js",
  "jsdelivr": "./dist/js/tabs.umd.js",
  "exports": {
    ".": {
      "types": "./dist/js/tabs.d.ts",
      "import": "./dist/js/tabs.mjs",
      "require": "./dist/js/tabs.cjs",
      "default": "./dist/js/tabs.mjs"
    },
    "./style.css": "./dist/css/styles.min.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:js": "vite build",
    "build:types": "cp src/js/script.d.ts dist/js/tabs.d.ts",
    "build:css": "sass src/scss/styles.scss:dist/css/styles.min.css --style=compressed --no-source-map",
    "build": "npm run build:js && npm run build:types && npm run build:css",
    "dev:js": "vite build --watch",
    "dev:css": "sass --watch src/scss/styles.scss:dist/css/styles.min.css --no-source-map",
    "test": "node --test",
    "test:package": "node scripts/package-smoke/run.js",
    "test:e2e": "playwright test",
    "prepublishOnly": "npm run build && npm test && npm run test:package"
  },
  "author": "Bartosz Trajder",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "jsdom": "^30.0.1",
    "sass": "^1.103.1",
    "vite": "^8.2.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sargadil/tabs.git"
  }
}
